generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ─────────────────────────────────────
//   ENUMS GENERALES
// ─────────────────────────────────────
//

enum UserRole {
  ADMIN
  JEFE
  LABORATORISTA
  CALIDAD
  AUDITOR
}

enum TestStatus {
  PENDING
  IN_PROGRESS
  DONE
  NEEDS_REVIEW
}

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum DocumentCategory {
  PROCEDURE
  WORK_INSTRUCTION
  FORMAT
  QUALITY_MANUAL
  TECHNICAL_NORM
  INTERNAL_POLICY
  OTHER
}

enum DocumentStatus {
  ACTIVE
  OBSOLETE
  UNDER_REVIEW
}

// ─────────────────────────────────────
//   EQUIPMENT / CALIBRACION / VERIFICACION (ISO 17025)
// ─────────────────────────────────────

// Categoria del equipo: determina que tipo de trazabilidad aplica.
// NORMATIVE: verificacion interna periodica, sin calibracion externa
//   (Mold, Pycnometer, SandCone).
// PRECISION: verificacion interna + calibracion externa acreditada
//   (balanza, horno de secado).
// REFERENCE_STANDARD: solo calibracion externa, ancla de trazabilidad
//   (pesas patron, termometro patron).
enum EquipmentCategory {
  NORMATIVE
  PRECISION
  REFERENCE_STANDARD
}

// Tipo de equipo fisico -- un valor por instrumento real.
// No agregar nuevos tipos sin confirmar periodicidad con Felipe.
enum EquipmentType {
  MOLD
  PYCNOMETER
  SAND_CONE
  SIEVE
  SCALE
  OVEN
  REFERENCE_WEIGHT
  REFERENCE_THERMOMETER
}

enum EquipmentStatus {
  ACTIVE
  OUT_OF_SERVICE
}

// Proctor
enum ProctorStatus {
  DRAFT
  DONE
  NEEDS_REVIEW
}

// CBR
enum CbrStatus {
  DRAFT
  DONE
  NEEDS_REVIEW
}

// Particle Density (NCh1532.Of80)
enum ParticleDensityStatus {
  DRAFT
  DONE
  NEEDS_REVIEW
}

// Tipo de contenedor del picnometro. Determina la precision de balanza
// exigida por la norma (frasco >=100ml -> 0.01g, botella >=50ml ->
// 0.001g) -- se guarda como dato informativo, sin validacion bloqueante
// (confirmado con el usuario 12-ago-2026).
enum PycnometerContainerType {
  FLASK
  BOTTLE
}

// Determinacion de Humedad (MC Vol.8 §8.102.2, jun-2022 -- adaptacion de
// NCh1515-79)
enum MoistureContentStatus {
  DRAFT
  DONE
  NEEDS_REVIEW
}

// Dos equipos segun rango de particulas: convencional (6", <=50mm) vs
// macrocono (12", 50-150mm). Determina el rango esperado de deposito y
// balanza (validacion informativa, sin bloqueo).
enum SandConeApparatusType {
  CONVENTIONAL
  MACRO
}

enum SandConeTestStatus {
  DRAFT
  DONE
  NEEDS_REVIEW
}

// Densidad Neta / Real de Gravas (NCh1117.Of2010). PRIMERA EXCEPCION a la
// regla de "un ensayo pertenece a una sola area": la norma es
// normativamente de aridos para hormigon (CONCRETE_AGGREGATES), pero el
// laboratorio tambien la usa para la fraccion >5mm de muestras de suelo
// (resuelve la deuda tecnica de Densidad de Particulas Solidas). Guard
// acepta SOIL_MECHANICS o CONCRETE_AGGREGATES. Confirmado con el usuario
// 12-ago-2026 -- no replicar esta excepcion a otros ensayos sin
// confirmacion explicita, sigue siendo el unico caso.
enum GravelDensityStatus {
  DRAFT
  DONE
  NEEDS_REVIEW
}

enum ProctorCurveFit {
  PARABOLA
  LINEAR_SEGMENTS
}

// Granulometria: a que serie de tamizado MOP 8.102.1 pertenece cada
// tamiz (5.4-5.5 vs 5.6-5.8). Declarado explicito, no inferido de
// openingMm, siguiendo la leccion del bug N40 (nunca inferir formato).
enum GranulometryFraction {
  OVER_5MM
  UNDER_5MM
}

// Area de laboratorio a la que pertenece cada muestra. CRITICO: separa
// normativas y modelos de ensayo que NO deben mezclarse entre si (ej:
// granulometria de suelos MOP 8.102.1 vs granulometria de aridos
// MOP 8.202.3 -- mismo concepto, tolerancias y procedimiento distintos).
// Cada modulo de ensayo nuevo debe validar que Sample.area coincida con
// el area a la que pertenece ese tipo de ensayo antes de crear el
// registro. Confirmado con el usuario 02-ago-2026.
enum LabArea {
  SOIL_MECHANICS
  CONCRETE_AGGREGATES
  MINE_INTERIOR
}

//
// ─────────────────────────────────────
//   USUARIOS Y ROLES
// ─────────────────────────────────────
//

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  assignedSamples   Sample[]           @relation("SampleAssignedTo")
  auditLogs         AuditLog[]
  createdDocuments  Document[]         @relation("DocumentCreatedBy")
  approvedDocuments Document[]         @relation("DocumentApprovedBy")
  testResults       TestResult[]
  documentRevisions DocumentRevision[]

  // Aprobaciones formales (regla ISO 17025: "reason obligatorio si ya
  // estaba aprobado"). Relaciones separadas de createdBy/testResults
  // porque quien aprueba NO tiene por qué ser quien ejecutó el ensayo
  // -- de hecho, para un auditor de INN, lo ideal es que sean personas
  // distintas (segregación de funciones).
  approvedTestResults       TestResult[]      @relation("TestResultApprovedBy")
  approvedProctors          Proctor[]         @relation("ProctorApprovedBy")
  approvedAtterbergs        Atterberg[]       @relation("AtterbergApprovedBy")
  approvedGranulometries    Granulometry[]    @relation("GranulometryApprovedBy")
  approvedCbrs              Cbr[]             @relation("CbrApprovedBy")
  approvedParticleDensities ParticleDensity[] @relation("ParticleDensityApprovedBy")
  approvedMoistureContents  MoistureContent[] @relation("MoistureContentApprovedBy")
  approvedSandConeTests     SandConeTest[]    @relation("SandConeTestApprovedBy")
  approvedGravelDensities   GravelDensity[]   @relation("GravelDensityApprovedBy")
}

//
// ─────────────────────────────────────
//   MUESTRAS
// ─────────────────────────────────────
//

model Sample {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  project      String
  location     String?
  materialType String
  receivedAt   DateTime
  receivedBy   String
  status       String
  notes        String?
  // Area de laboratorio (SOIL_MECHANICS/CONCRETE_AGGREGATES/MINE_INTERIOR).
  // Obligatorio, SIN default -- debe declararse explicitamente en cada
  // muestra nueva. Separa normativas y modelos de ensayo que no deben
  // mezclarse entre areas (confirmado con el usuario 02-ago-2026).
  area         LabArea
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Asignación (opcional)
  assignedToId Int?
  assignedTo   User? @relation("SampleAssignedTo", fields: [assignedToId], references: [id])

  // relaciones 1:1 (por muestra)
  atterberg Atterberg?

  // relaciones 1:N
  tests          Test[]
  granulometries Granulometry[]
  attachments    Attachment[]

  // Proctor: puede ser más de uno por muestra
  proctors Proctor[]

  // CBR: puede ser más de uno por muestra
  cbrs Cbr[]

  // Densidad de Particulas Solidas (NCh1532.Of80): puede repetirse
  // (la norma recomienda dos ensayos como verificacion cruzada, sin
  // umbral de bloqueo automatico).
  particleDensities ParticleDensity[]

  // Determinacion de Humedad (MC Vol.8 §8.102.2): puede repetirse por
  // muestra. Diseñado para ser referenciado por otros ensayos futuros via
  // FK opcional (ej. Cono de Arena, moistureContentId) -- ver CLAUDE.md.
  moistureContents MoistureContent[]

  // Cono de Arena (NCh1516.Of79): puede repetirse por muestra (un punto
  // de ensayo de terreno por registro).
  sandConeTests SandConeTest[]

  // Densidad Neta / Real de Gravas (NCh1117.Of2010): unico ensayo valido
  // para dos areas (SOIL_MECHANICS y CONCRETE_AGGREGATES), ver guard en
  // gravelDensity.service.ts.
  gravelDensities GravelDensity[]
}

//
// ─────────────────────────────────────
//   ATTERBERG (1:1 por muestra)
// ─────────────────────────────────────
//

model Atterberg {
  id       Int    @id @default(autoincrement())
  sampleId Int    @unique
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  method        String? // ej: "NCh ..." / MOP
  liquidLimit   Float? // LL
  plasticLimit  Float? // LP (puede ser null si "NP")
  plasticityIdx Float? // IP

  // Aprobación formal (ISO 17025)
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("AtterbergApprovedBy", fields: [approvedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ─────────────────────────────────────
//   ÓRDENES DE ENSAYO
// ─────────────────────────────────────
//

model Order {
  id            Int      @id @default(autoincrement())
  client        String
  sampleType    String
  testRequested String
  createdAt     DateTime @default(now())
}

//
// ─────────────────────────────────────
//   ENSAYOS
// ─────────────────────────────────────
//

model Test {
  id        Int        @id @default(autoincrement())
  sampleId  Int
  type      String
  norm      String?
  status    TestStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sample      Sample       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  results     TestResult[]
  alerts      Alert[]
  attachments Attachment[]
}

//
// ─────────────────────────────────────
//   RESULTADOS DE ENSAYO
// ─────────────────────────────────────
//

model TestResult {
  id             Int      @id @default(autoincrement())
  testId         Int
  rawInputJson   Json
  calculatedJson Json
  isValid        Boolean  @default(true)
  createdById    Int
  createdAt      DateTime @default(now())

  // Aprobación formal (ISO 17025)
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("TestResultApprovedBy", fields: [approvedById], references: [id])

  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
  alerts    Alert[]
}

//
// ─────────────────────────────────────
//   ALERTAS
// ─────────────────────────────────────
//

model Alert {
  id           Int        @id @default(autoincrement())
  testId       Int?
  testResultId Int?
  level        AlertLevel
  message      String
  suggestion   String?
  createdAt    DateTime   @default(now())

  test       Test?       @relation(fields: [testId], references: [id], onDelete: Cascade)
  testResult TestResult? @relation(fields: [testResultId], references: [id], onDelete: Cascade)
}

//
// ─────────────────────────────────────
//   EVIDENCIAS / ADJUNTOS
// ─────────────────────────────────────
//

model Attachment {
  id          Int      @id @default(autoincrement())
  url         String
  type        String // photo, video, pdf, etc.
  sampleId    Int?
  testId      Int?
  documentId  Int?
  // Certificados de calibracion externa (PRECISION / REFERENCE_STANDARD).
  // Mismo patron de FKs opcionales: un registro tiene solo uno poblado.
  equipmentId Int?
  uploadedAt  DateTime @default(now())

  sample    Sample?    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  test      Test?      @relation(fields: [testId], references: [id], onDelete: Cascade)
  document  Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
}

//
// ─────────────────────────────────────
//   AUDITORÍA INTERNA
// ─────────────────────────────────────
//

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  CALIBRATE
  VERIFY     // verificacion interna periodica (distinta de CALIBRATE que es certificacion externa)
  ROLE_CHANGE
  LOGIN
  OTHER
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  userId        Int
  action        AuditAction
  entityType    String
  entityId      Int
  previousValue Json?
  newValue      Json?
  reason        String?
  createdAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

//
// ─────────────────────────────────────
//   CONTROL DOCUMENTAL
// ─────────────────────────────────────
//

model Document {
  id           Int              @id @default(autoincrement())
  code         String           @unique
  title        String
  category     DocumentCategory
  description  String?
  version      String           @default("1.0")
  // FIX (auditoria 02-ago-2026): el default era ACTIVE, lo que activaba
  // un documento recien creado sin pasar por aprobacion -- contradice el
  // ciclo de vida ISO 9001 (UNDER_REVIEW -> ACTIVE via approve -> OBSOLETE).
  status       DocumentStatus   @default(UNDER_REVIEW)
  fileUrl      String?
  createdById  Int
  approvedById Int?

  // Aprobacion formal (ISO 9001 7.5.2 -- documento revisado y aprobado
  // antes de emitirse). Mismo patron que TestResult/Atterberg/
  // Granulometry/Proctor, para reusar approvalGuard.ts sin reinventar.
  isApproved Boolean   @default(false)
  approvedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  effectiveDate DateTime?
  obsoleteDate  DateTime?

  createdBy  User  @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  approvedBy User? @relation("DocumentApprovedBy", fields: [approvedById], references: [id])

  revisions   DocumentRevision[]
  attachments Attachment[]
}

model DocumentRevision {
  id          Int      @id @default(autoincrement())
  documentId  Int
  version     String
  changes     String?
  updatedById Int
  updatedAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  updatedBy User     @relation(fields: [updatedById], references: [id])
}

//
// ─────────────────────────────────────
//   GRANULOMETRÍA
// ─────────────────────────────────────
//

model Granulometry {
  id       Int    @id @default(autoincrement())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  method       String?
  totalDryMass Float

  // Sobre-tamaño
  sampleTotalMass Float?
  tmaSpecifiedMm  Float?
  tmaSampleMm     Float?
  oversizeMass    Float?
  oversizePercent Float?

  // Control de cierre general
  errorPercent Float?

  notes String?

  // Cálculos automáticos
  d10       Float?
  d30       Float?
  d60       Float?
  cu        Float?
  cc        Float?
  calcNotes String?

  // QA MOP (cierre por fracción 5 mm)
  massOver5mm_D      Float?
  massOver5mm_Dprime Float?
  residueOver5mm     Float?

  massUnder5mm_C            Float?
  massUnder5mm_Cprime       Float?
  massUnder5mm_CprimeWashed Float?
  residueUnder5mm           Float?

  errorPercentOver5mm  Float?
  errorPercentUnder5mm Float?
  qaStatus             String?

  // Aprobación formal (ISO 17025)
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("GranulometryApprovedBy", fields: [approvedById], references: [id])

  sieves GranulometrySieve[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GranulometrySieve {
  id             Int          @id @default(autoincrement())
  granulometryId Int
  granulometry   Granulometry @relation(fields: [granulometryId], references: [id], onDelete: Cascade)

  order           Int
  sieveLabel      String
  openingMm       Float?
  retainedMass    Float
  percentRetained Float
  percentPassing  Float

  // MOP 8.102.1: serie gruesa (5.4-5.5, formula 6.2, sobre D') vs serie
  // fina (5.6-5.8, formula 6.3, sobre C''). Obligatorio, sin default.
  fraction GranulometryFraction

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([granulometryId])
  @@index([order])
}

//
// ─────────────────────────────────────
//   EQUIPMENT (ISO 17025) — catálogo padre de todos los instrumentos
// ─────────────────────────────────────
//
// Tabla padre unica para Mold, Pycnometer y SandCone (NORMATIVE) y
// para equipos de medicion (PRECISION: balanza, horno) y patrones
// (REFERENCE_STANDARD: pesas patron, termometro patron).
//
// Las tablas de detalle (Mold, Pycnometer, SandCone) conservan sus
// columnas especificas de calibracion/verificacion tipadas porque cada
// instrumento tiene un procedimiento distinto que NO se puede unificar
// en JSON generico sin perder trazabilidad normativa.

model Equipment {
  id          Int               @id @default(autoincrement())
  code        String            @unique // rotulacion ISO 17025, unico en TODO el catalogo
  type        EquipmentType
  category    EquipmentCategory
  description String?
  status      EquipmentStatus   @default(ACTIVE)

  // Calibracion externa acreditada -- SOLO PRECISION y REFERENCE_STANDARD.
  // Para NORMATIVE estos campos quedan null (sin calibracion externa).
  lastCalibrationAt DateTime?
  calibrationDueAt  DateTime?
  calibrationBody   String? // nombre del organismo metrologico acreditado

  // Verificacion interna -- aplica a PRECISION (verificado contra patron).
  // NORMATIVE tiene sus campos de verificacion en la tabla de detalle
  // (Mold.verificationDueAt, Pycnometer.verificationDueAt,
  // SandCone.depositVerificationDueAt / sandDensityVerificationDueAt).
  lastVerificationAt DateTime?
  verificationDueAt  DateTime?

  // Relaciones a tablas de detalle (1:1, opcionales porque un Equipment
  // puede ser PRECISION/REFERENCE_STANDARD y no tener tabla de detalle).
  mold       Mold?
  pycnometer Pycnometer?
  sandCone   SandCone?
  sieve      Sieve?

  usages      EquipmentUsage[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([status])
}

// Tamiz individual (instrumento trazable, un registro por tamiz físico).
// Categoría NORMATIVE, verificación interna 6 meses (confirmado por Felipe).
// Sin calibración externa acreditada.
// astmDesignation: nomenclatura normativa (ej: "N°4", "3/4\"", "N°200"),
// coincide con los sieveLabel ya usados en granulometryCalc.ts para
// mantener auditabilidad línea a línea contra MOP 8.102.1.
// openingMm: abertura EXACTA en mm según ASTM E11 / MOP 8.102.1 --
// nunca un valor redondeado (ej: N°40 = 0.425, NO 0.5; N°200 = 0.075, NO 0.08).
model Sieve {
  id          Int       @id @default(autoincrement())
  equipmentId Int       @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  astmDesignation String  // ej: "N°4", "3/4\"", "N°40", "N°200"
  openingMm       Float   // abertura normada exacta en mm

  lastVerificationAt DateTime?
  verificationDueAt  DateTime?  // periodicidad 6 meses (confirmado Felipe)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabla puente polimórfica: registra qué equipos se usaron en cada
// registro de ensayo. El par (entityType, entityId) apunta al ID de
// la tabla del ensayo correspondiente (Granulometry, Proctor, etc.).
model EquipmentUsage {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  entityType String // "GRANULOMETRY" | "PROCTOR" | "CBR" | "ATTERBERG" |
                     // "PARTICLE_DENSITY" | "MOISTURE_CONTENT" |
                     // "SAND_CONE_TEST" | "GRAVEL_DENSITY"
  entityId   Int

  createdAt DateTime @default(now())

  @@index([equipmentId])
  @@index([entityType, entityId])
}

//
// ─────────────────────────────────────
//   PROCTOR - CATÁLOGO DE MOLDES + ENSAYO + PUNTOS
// ─────────────────────────────────────
//

model Mold {
  id          Int       @id @default(autoincrement())
  // Vinculo obligatorio al catalogo de equipos (1:1).
  // code/status/descripcion del equipo viven en Equipment.
  equipmentId Int       @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  description String?
  volumeCm3   Float   // volumen nominal (cm³)
  tareMassG   Float?  // masa molde (g)
  collarMassG Float?  // masa collar (g) si aplica
  // Altura de la probeta (mm). Obligatoria en CBR para swellPercent
  // (NCh1852.Of81), opcional para Proctor donde no se mide hinchamiento.
  heightMm    Float?

  // Verificacion interna -- periodicidad 3 meses (confirmado por Felipe).
  // Registrada via POST /api/molds/:id/verify (AuditAction.VERIFY).
  // El guard de ensayo (equipmentGuard.ts) bloquea si verificationDueAt
  // < hoy o es null.
  lastVerificationAt DateTime?
  verificationDueAt  DateTime?

  proctorPoints ProctorPoint[]
  cbrPoints     CbrPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proctor {
  id       Int    @id @default(autoincrement())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  // Método / norma (cliente puede pedir variantes)
  methodCode String? // ej: "NCh1534-1", "NCh1534-2", "ASTM D698", "ASTM D1557"
  methodName String? // texto libre para UI

  // Config ensayo
  layers        Int?
  blowsPerLayer Int?
  status        ProctorStatus @default(DRAFT)

  // Override controlado (si después lo ocupas)
  overrideReason String?
  overrideById   Int?
  overrideAt     DateTime?

  // Resultados calculados
  omcPercent    Float? // humedad óptima
  mddDryDensity Float? // densidad seca máxima
  curveFit      ProctorCurveFit? @default(PARABOLA)

  // Aprobación formal (ISO 17025)
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("ProctorApprovedBy", fields: [approvedById], references: [id])

  // Gráfico
  chartJson Json?
  chartUrl  String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  points ProctorPoint[]
  // CBR que toma este Proctor como referencia de DMCS (95%)
  cbrs   Cbr[]

  @@index([sampleId])
  @@index([status])
}

model ProctorPoint {
  id        Int     @id @default(autoincrement())
  proctorId Int
  proctor   Proctor @relation(fields: [proctorId], references: [id], onDelete: Cascade)

  // Mold elegido por catálogo
  moldId Int
  mold   Mold @relation(fields: [moldId], references: [id])

  order Int // 1..n

  // INPUT operador
  wetMassMoldPlusSoilG Float // masa molde + suelo húmedo (g)

  // Humedad: puedes ingresar directa o por tarros
  waterContentPercent Float?
  tinTareG            Float?
  tinWetG             Float?
  tinDryG             Float?

  // CALCULATED
  wetDensity Float?
  dryDensity Float?

  qaFlags Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([proctorId, order])
  @@index([proctorId])
  @@index([moldId])
}

//
// ─────────────────────────────────────
//   CBR (Indice de Soporte California) - NCh1852.Of81
// ─────────────────────────────────────
//

model Cbr {
  id       Int    @id @default(autoincrement())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  // Referencia obligatoria al Proctor de la misma muestra: el CBR de
  // diseno se interpola al 95% de la DMCS (densidad maxima seca) de ese
  // Proctor. Confirmado con el usuario 11-ago-2026.
  proctorId Int
  proctor   Proctor @relation(fields: [proctorId], references: [id])

  methodCode String?   @default("NCh1852.Of81")
  status     CbrStatus @default(DRAFT)

  // Resultado final (interpolacion al 95% DMCS)
  designCbrPercent Float?
  curveJson        Json?

  // Aprobación formal (ISO 17025)
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("CbrApprovedBy", fields: [approvedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  points CbrPoint[]

  @@index([sampleId])
  @@index([proctorId])
}

model CbrPoint {
  id    Int @id @default(autoincrement())
  cbrId Int
  cbr   Cbr @relation(fields: [cbrId], references: [id], onDelete: Cascade)

  // Mold elegido por catálogo (reusa el mismo catalogo que Proctor)
  moldId Int
  mold   Mold @relation(fields: [moldId], references: [id])

  order         Int // 1..n
  blowsPerLayer Int // energia de este punto (ej: 12/25/56 golpes)
  layers        Int @default(5)

  // INPUT operador -- compactacion (mismo patron que ProctorPoint)
  wetMassMoldPlusSoilG Float // masa molde + suelo húmedo (g)

  waterContentPercent Float?
  tinTareG            Float?
  tinWetG             Float?
  tinDryG             Float?

  // CALCULATED -- compactacion
  wetDensity Float?
  dryDensity Float?

  // INPUT operador -- hinchamiento (inmersion 4 dias / 96h)
  swellInitialDialMm Float?
  swellFinalDialMm   Float?

  // CALCULATED -- hinchamiento
  swellPercent Float?

  // INPUT operador -- penetracion (carga a 0.1" y 0.2", en kg/cm2)
  loadAt01inKgCm2 Float?
  loadAt02inKgCm2 Float?

  // CALCULATED -- penetracion (contra presion patron NCh1852.Of81)
  cbr01Percent Float?
  cbr02Percent Float?
  cbrPercent   Float?

  qaFlags Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cbrId, order])
  @@index([cbrId])
  @@index([moldId])
}

//
// ─────────────────────────────────────
//   PICNOMETRO (instrumento trazable) + DENSIDAD DE PARTICULAS SOLIDAS
//   NCh1532.Of80 (equivalente ASTM D854-58)
// ─────────────────────────────────────
//

model Pycnometer {
  id          Int       @id @default(autoincrement())
  equipmentId Int       @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  description       String?
  containerType     PycnometerContainerType?
  nominalCapacityMl Float?

  // Calibracion geometrica (procedimiento independiente, reutilizable
  // entre ensayos -- se registra una sola vez, ver POST /:id/calibrate).
  // Simbolos identicos a NCh1532.Of80 para auditar linea a linea.
  // Mf: masa del picnometro vacio y seco
  massEmptyG          Float?
  // Ma(ti): masa picnometro + agua a temperatura de calibracion
  massWaterAtCalTempG Float?
  // ti: temperatura de calibracion
  calibrationTempC    Float?

  // Verificacion interna -- periodicidad 6 meses (confirmado por Felipe).
  lastVerificationAt DateTime?
  verificationDueAt  DateTime?

  particleDensities ParticleDensity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParticleDensity {
  id       Int    @id @default(autoincrement())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  pycnometerId Int
  pycnometer   Pycnometer @relation(fields: [pycnometerId], references: [id])

  methodCode String?               @default("NCh1532.Of80")
  status     ParticleDensityStatus @default(DRAFT)

  // Alcance de esta fase: solo particulas < 5mm (metodo picnometro).
  // El caso mixto (>5mm + <5mm, promedio ponderado por NCh1117) queda
  // fuera de alcance -- ver deuda tecnica en CLAUDE.md.
  containerType     PycnometerContainerType?
  balancePrecisionG Float? // informativo, sin validacion bloqueante

  // INPUT operador (mismos simbolos que la norma, para auditar linea a
  // linea contra el texto oficial)
  msG       Float // masa seca de la muestra de ensayo
  mmG       Float // masa picnometro + muestra + agua a tx
  testTempC Float // tx: temperatura de ensayo (aprox. a 1°C)

  // CALCULATED
  maAtTestTempG       Float? // Ma(tx), interpolado desde la calibracion del picnometro
  waterDensityAtTestG Float? // ρw(tx)
  particleDensityGcm3 Float? // ρs

  calcNote String? // ej: si tx cae fuera de la tabla 16-29°C

  // Aprobación formal (ISO 17025) -- sin qaStatus bloqueante, la norma no
  // define umbral numerico (solo recomienda repetir el ensayo).
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("ParticleDensityApprovedBy", fields: [approvedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sampleId])
  @@index([pycnometerId])
}

//
// ─────────────────────────────────────
//   DETERMINACION DE HUMEDAD
//   MC Vol.8 §8.102.2 (jun-2022, adaptacion de NCh1515-79)
// ─────────────────────────────────────
//

model MoistureContent {
  id       Int    @id @default(autoincrement())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  methodCode String?               @default("MC Vol.8 §8.102.2")
  status     MoistureContentStatus @default(DRAFT)

  // INPUT operador (mismos simbolos que la norma, para auditar linea a
  // linea contra el texto oficial)
  mrG         Float // masa recipiente solo (vacio, seco, con tapa)
  mhG         Float // masa recipiente + muestra humeda
  msG         Float // masa recipiente + muestra seca
  // Temperatura de secado usada (110±5°C normal, 60±5°C para suelos con
  // yeso/materia organica -- Nota 2). Valor libre, sin forzar 110/60:
  // el operador puede justificar otros valores en casos especiales.
  dryingTempC Float

  // CALCULATED
  wPercent Float? // w = 100 * (mh - ms) / (ms - mr), aprox. al 0.1%

  calcNote String?

  // Aprobación formal (ISO 17025) -- sin qaStatus bloqueante: la norma no
  // define un criterio de aceptacion/rechazo del valor de humedad (solo
  // masa constante durante el secado, que es procedimiento de laboratorio,
  // no verificable por software).
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("MoistureContentApprovedBy", fields: [approvedById], references: [id])

  // Nota normativa 4: la muestra usada para humedad se descarta, no se
  // reutiliza en otro ensayo -- no hay accion de software, queda como
  // recordatorio para quien opere el formulario/cliente de esta API.
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensayos que referencian esta determinacion de humedad por relacion
  // (ej. Cono de Arena) en vez de calcularla internamente.
  sandConeTests SandConeTest[]

  @@index([sampleId])
}

//
// ─────────────────────────────────────
//   CONO DE ARENA (instrumento) + DENSIDAD EN EL TERRENO
//   MC Vol.8 §8.102.9 (jun-2022, adaptacion de NCh1516-79)
// ─────────────────────────────────────
//

model SandCone {
  id          Int       @id @default(autoincrement())
  equipmentId Int       @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  description String?

  // Tipo de aparato: cono convencional (6", <=50mm particulas) o
  // macrocono (12", 50-150mm particulas). Obligatorio, sin default --
  // determina que rango de deposito/balanza corresponde (validacion
  // informativa, sin bloqueo, ver apparatusCoherenceWarning en el
  // controller).
  apparatusType SandConeApparatusType

  // Datos informativos del aparato para la validacion cruzada de
  // coherencia con apparatusType (sin bloqueo -- dato de catalogo, no
  // tolerancia normativa numerica).
  depositDiameterMm  Float? // 165mm convencional / 300mm macrocono
  balanceResolutionG Float? // 1g convencional / 10g macrocono

  // ── Calibracion 1: capacidad volumetrica del deposito (Vm) ──
  // Se hace una sola vez por deposito, se reutiliza en las calibraciones
  // de arena posteriores que usen ese mismo deposito. Vm se aproxima a
  // 1 cm3 (§8.102.9).
  depositMassWaterG   Float? // mw
  depositWaterTempC   Float? // temperatura de esa calibracion
  depositVolumeCm3    Float? // Vm = mw / ρw(tempC), redondeado a 1 cm3
  depositCalibratedAt DateTime?
  // Verificacion interna deposito/cono -- periodicidad 6 meses (Felipe).
  depositVerificationDueAt DateTime?

  // ── Calibracion 2: densidad aparente de la arena de ensayo (ρA) ──
  // 5 determinaciones completas, se promedian TODAS (no se descartan ni
  // se eligen las 3 mas proximas). Criterio de aceptacion: variacion
  // entre las 5 <= 1.5% -- si no se cumple, se rechaza el conjunto
  // completo (bloqueante, 400). ρA final con 2 decimales. Fechada
  // porque la arena se degrada con el tiempo.
  sandDensityRawJson          Json? // las 5 determinaciones {order, maG, rhoAGcm3}
  sandDensityVariationPercent Float? // variacion entre las 5 (debe ser <= 1.5%)
  sandDensityGcm3             Float? // ρA final = promedio de las 5, 2 decimales
  sandDensityCalibratedAt     DateTime?
  // Verificacion interna arena -- periodicidad 3 meses (confirmado por
  // Felipe). Bloqueante via equipmentGuard si es null o < hoy.
  sandDensityVerificationDueAt DateTime?

  // ── Calibracion 3: masa de arena que llena el cono/embudo (mC) ──
  // Se repite 3 veces (no una sola vez). Criterio de aceptacion:
  // variacion entre las 3 <= 1.0% -- si no se cumple, se rechaza
  // (bloqueante, 400). mC final = promedio de las 3. Especifica a la
  // combinacion aparato + tipo de arena.
  funnelRawJson          Json? // las 3 determinaciones {order, miG, mfG, mCG}
  funnelVariationPercent Float? // variacion entre las 3 (debe ser <= 1.0%)
  funnelMassG            Float? // mC final = promedio de las 3
  funnelCalibratedAt     DateTime?

  tests SandConeTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SandConeTest {
  id       Int    @id @default(autoincrement())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  sandConeId Int
  sandCone   SandCone @relation(fields: [sandConeId], references: [id])

  // Dependencia obligatoria: la humedad (ω) se lee de un MoistureContent
  // ya existente, no se recibe como campo suelto. Debe pertenecer a la
  // misma muestra (validado en el service). Idealmente ya aprobado, pero
  // no se bloquea si no lo esta -- solo se exige que exista y tenga
  // wPercent calculado (si no, el calculo de este ensayo queda con nota
  // y sin resultado, mismo criterio que CBR con Proctor.mddDryDensity).
  moistureContentId Int
  moistureContent   MoistureContent @relation(fields: [moistureContentId], references: [id])

  methodCode String?            @default("MC Vol.8 §8.102.9")
  status     SandConeTestStatus @default(DRAFT)

  // Tamaño minimo de excavacion segun tabla de la norma (informativo,
  // sin validacion automatica -- dato de campo no verificable por
  // software).
  minExcavationVolumeCm3 Float?

  // INPUT operador (mismos simbolos que la norma: mti/mtf, no mi/mf --
  // para no confundir con las determinaciones de calibracion mI/mF)
  mtiG Float // masa aparato + arena, antes de llenar la perforacion
  mtfG Float // masa aparato + arena, despues de llenar la perforacion
  mhG  Float // masa del material humedo extraido de la perforacion

  // CALCULATED
  mpG            Float? // mp = (mti - mtf) - mC (arena efectivamente en la perforacion)
  msG            Float? // ms = mh / (1 + ω/100)
  volumeCm3      Float? // Vp = mp / ρA
  dryDensityGcm3 Float? // ρd = ms / Vp (resultado principal)
  wetDensityGcm3 Float? // ρh = mh / Vp (informativo)

  calcNote String?

  // Aprobación formal (ISO 17025) -- sin qaStatus bloqueante en el
  // resultado de campo: la norma no define tolerancia de aceptacion para
  // ρd (las tolerancias explicitas de la norma aplican a la calibracion
  // de la arena y el embudo, ver SandCone, no al resultado de este
  // ensayo).
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("SandConeTestApprovedBy", fields: [approvedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sampleId])
  @@index([sandConeId])
  @@index([moistureContentId])
}

//
// ─────────────────────────────────────
//   DENSIDAD NETA / REAL DE GRAVAS
//   NCh1117.Of2010
// ─────────────────────────────────────
//

model GravelDensity {
  id       Int    @id @default(autoincrement())
  sampleId Int
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  methodCode String?             @default("NCh1117.Of2010")
  status     GravelDensityStatus @default(DRAFT)

  // Tamaño maximo nominal del arido (Tabla 1 de la norma define masa
  // minima de muestra segun este valor) -- informativo, sin bloqueo.
  maxNominalSizeMm Float?

  // La norma exige "muestras gemelas" (dos determinaciones independientes
  // A/B/C, mismos simbolos que la norma):
  //   A = masa sumergida (SSS menos agua desplazada)
  //   B = masa saturada superficialmente seca (SSS), al aire
  //   C = masa seca al horno, al aire
  aG1 Float
  bG1 Float
  cG1 Float

  aG2 Float
  bG2 Float
  cG2 Float

  // CALCULATED por muestra gemela (aproximado a 1 kg/m3, norma 10.1)
  realSssDensity1Kgm3 Float? // ρRsss,1 = B1/(B1-A1) * 1000
  realDryDensity1Kgm3 Float? // ρRS,1 = C1/(B1-A1) * 1000
  netDensity1Kgm3     Float? // ρN,1 = C1/(C1-A1) * 1000
  absorption1Percent  Float? // (B1-C1)/C1 * 100

  realSssDensity2Kgm3 Float?
  realDryDensity2Kgm3 Float?
  netDensity2Kgm3     Float?
  absorption2Percent  Float?

  // Diferencias entre gemelas -- tolerancia bloqueante de la norma
  // (10.3.1): <= 30 kg/m3 en cada densidad, <= 0.3% en absorcion. Si se
  // excede, la creacion/edicion se rechaza con 400 (ensayar dos muestras
  // gemelas nuevas).
  realSssDensityDiffKgm3 Float?
  realDryDensityDiffKgm3 Float?
  netDensityDiffKgm3     Float?
  absorptionDiffPercent  Float?

  // CALCULATED final = promedio aritmetico de ambas gemelas (norma 11:
  // densidades aprox. a 10 kg/m3, absorcion a 0.1%)
  realSssDensityKgm3 Float?
  realDryDensityKgm3 Float?
  netDensityKgm3     Float?
  absorptionPercent  Float?

  calcNote String?

  // Aprobación formal (ISO 17025). Sin qaStatus adicional: la tolerancia
  // de la norma ya actua como bloqueo duro en create/update (arriba), no
  // hace falta un segundo criterio de calidad sobre el resultado final.
  isApproved   Boolean   @default(false)
  approvedById Int?
  approvedAt   DateTime?
  approvedBy   User?     @relation("GravelDensityApprovedBy", fields: [approvedById], references: [id])

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sampleId])
}
